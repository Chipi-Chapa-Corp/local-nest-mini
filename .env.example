# OpenAI-compatible API base URL, including its version prefix (e.g. /v1).
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=your-model
# Optional; leave empty for a server without authentication.
LLM_API_KEY=
# Optional; sent as reasoning_effort only when set, using your provider's values.
LLM_REASONING_EFFORT=
