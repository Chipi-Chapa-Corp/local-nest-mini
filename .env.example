# OpenAI-compatible API base URL, including its version prefix (e.g. /v1).
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=your-model
# auto selects Responses for api.openai.com, Chat Completions for other hosts.
# Override with responses or chat_completions when your provider requires it.
LLM_API=auto
# Optional; leave empty for a server without authentication.
LLM_API_KEY=
# Optional; sent in the selected API's reasoning format when set.
LLM_REASONING_EFFORT=
# Opt in to streamed text and sentence playback: native first, then Cast.
LLM_STREAMING=0
# Optional: enable Keenable web_search and read_web_page (five calls per response).
KEENABLE_API_KEY=
