NEST_IP=192.168.0.206
NEST_MAC=aa:bb:cc:dd:ee:ff
PC_IP=192.168.0.111
GATEWAY=192.168.0.1
INTERFACE=eno1
DURATION=3600

# "distrobox-host-exec" runs the root helper on the host.
# Leave empty when running directly on the host.
HOST_EXEC=distrobox-host-exec

# Public base URL for TTS files as reached by the Nest (proxy port 80).
PUBLIC_BASE_URL=http://192.168.0.111:8099/tts
STT_THREADS=6
# LLM_BASE_URL, LLM_MODEL, and optional LLM_API_KEY / LLM_REASONING_EFFORT
# can be set here or in .env (see .env.example; .env takes precedence).
# OmniVoice: GPU (Vulkan, omnivoice.cpp Q8_0) when the discrete GPU has more
# than OMNIVOICE_GPU_MIN_FREE_MIB of free VRAM, otherwise optimized CPU.
# Run bash host/setup-omnivoice.sh (CPU, required) and
# bash host/setup-omnivoice-vulkan.sh (GPU, optional) first.
# Runtime uses local assets only; Russian clones the saved English reference.
TTS_BACKEND=omnivoice
OMNIVOICE_GPU=auto
OMNIVOICE_GPU_STEPS=24
OMNIVOICE_GPU_MIN_FREE_MIB=1740
# CPU fallback, with the same step count as the GPU path.
OMNIVOICE_THREADS=6
OMNIVOICE_STEPS_EN=24
OMNIVOICE_STEPS_RU=24
# Legacy Kitten settings, used only when explicitly selecting that backend.
KITTEN_DECODER=default
KITTEN_THREADS=6
KITTEN_DECODER_THREADS=2
KITTEN_VOICE_EN=Bruno
KITTEN_VOICE_RU=Russian
PROJECT_NAME=local-nest-mini

# 0 means the systemd service runs until stopped.
SERVICE_DURATION=0

# Local assistant and native S3 response injection (Cast fallback)
ASSISTANT_ENABLED=1
ASSISTANT_URL=http://127.0.0.1:8099
ASSISTANT_LANG=auto
PLAYER_ENABLED=1
OUTPUT_MODE=native
ALLOW_GOOGLE_UPSTREAM=0
# Server-side end of utterance (Google does this; the Nest waits for it).
# Seconds of trailing silence before the reply; raise if pauses get cut off.
S3_ENDPOINT_SILENCE=1.8
# Close a turn quietly when nobody speaks within this many seconds.
S3_NO_SPEECH=5
NATIVE_TEMPLATE=
NATIVE_BITRATE=32k
CAST_DISCOVERY_TIMEOUT=3
CAST_CONNECT_TIMEOUT=3
CAST_NAME="Office speaker"

# Task monitor. Bind 0.0.0.0 only if you need LAN access.
MONITOR_ENABLED=1
MONITOR_HOST=127.0.0.1
MONITOR_PORT=53412
